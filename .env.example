# Bind the dashboard only to loopback. Reach it remotely through an SSH tunnel or a VPN.
DASHBOARD_BIND=127.0.0.1:8080
POSTGRES_DB=gaban
POSTGRES_USER=gaban
POSTGRES_PASSWORD=replace-with-a-long-unique-password
REDIS_URL=redis://redis:6379/0

# Keep provider credentials out of Git. Configure agent-specific secrets during their
# official onboarding; do not paste them into compose files or task prompts.

